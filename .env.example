# Docker 部署配置（复制为 .env）
# 本仓库发布的 Docker Hub 镜像地址；参见 README 的部署说明。
BEHEMOTH_IMAGE=ruoji6/behemoth
BEHEMOTH_TAG=latest
POSTGRES_USER=behemoth
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=behemoth

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BEHEMOTH_LLM_PROVIDER=
BEHEMOTH_LLM_MODEL=
BEHEMOTH_LLM_BASE_URL=
BEHEMOTH_LLM_PROXY=

# HTTP User-Agent；留空时从浏览器 UA 样本中随机抽选，填写则使用固定值
BEHEMOTH_HTTP_USER_AGENT=

# 代理供应商认证页节流（默认开启）：登录/注册类页面经代理时按域名限速，超限返回
# 429 + Retry-After，上游 407/429/403 触发冷却。`BEHEMOTH_AUTH_THROTTLE=0` 关闭。
# BEHEMOTH_AUTH_THROTTLE_PER_MINUTE=6
# BEHEMOTH_AUTH_THROTTLE_PER_HOUR=20
# BEHEMOTH_AUTH_THROTTLE_HOST_PER_MINUTE=180
# BEHEMOTH_AUTH_THROTTLE_COOLDOWN_SECONDS=1800

# 禁止直连出口（默认开启）：没有任何出站代理（代理池/Tor/全局代理/隧道覆盖）时，
# 本地正向代理对所有外部请求返回 503，代理抓取（scrape_online_proxies）可用于
# 自举出口；置 1 恢复旧的直连行为。
# BEHEMOTH_ALLOW_DIRECT_EGRESS=1

# Multi-engine search (optional; also configurable in /system/settings)
# Firecrawl: cloud API key, bare self-hosted base URL, or "key|base_url"
SEARCH_FIRECRAWL_API_KEY=
# SEARCH_FIRECRAWL_URL=https://api.firecrawl.dev
SEARCH_TAVILY_API_KEY=
SEARCH_BRAVE_API_KEY=
# SearXNG: leave empty to auto-detect the self-hosted instance that
# `sudo ./setup.sh searxng` (or `full`/`update`) provisions on 127.0.0.1:8888
SEARCH_SEARXNG_URL=

# CAPTCHA solving service (optional; 2Captcha-compatible, used by solve_captcha mode=token
# for reCAPTCHA/hCaptcha/Turnstile; also configurable as the captcha_api_key setting)
CAPTCHA_API_KEY=
# CAPTCHA_BASE_URL=https://2captcha.com

# C2 capability (optional; implants + operator console at /c2/ui/)
# Dedicated listener address for implant beacons; empty = share the main 8787 port.
# BEHEMOTH_C2_ADDR=0.0.0.0:8443
# BEHEMOTH_C2_PORT=127.0.0.1:8443
# Public URL implants call back to (used as the generated implant's default base URL).
# BEHEMOTH_C2_PUBLIC_URL=https://c2.example.com
# Optional shared beacon secret accepted for every implant (per-implant tokens always work).
# BEHEMOTH_C2_SECRET=
# Optional TLS for the dedicated listener.
# BEHEMOTH_C2_TLS_CERT=/path/cert.pem
# BEHEMOTH_C2_TLS_KEY=/path/key.pem
