{"id": "sqlmap-injection", "name": "SQLMap SQL Injection", "description": "Detect and exploit SQL injection vulnerabilities using SQLMap", "category": "exploitation", "version": "1.0.0", "author": "ARTEX", "tags": ["sqli", "database", "injection"], "command": "sqlmap -u \"{url}\" --batch --level={level} --risk={risk} --output-dir={outdir}", "parameters": [{"name": "url", "type": "string", "required": true, "description": "Target URL with parameter"}, {"name": "level", "type": "int", "required": false, "default": 3, "description": "Level of tests (1-5)"}, {"name": "risk", "type": "int", "required": false, "default": 2, "description": "Risk of tests (1-3)"}, {"name": "outdir", "type": "string", "required": false, "default": "/tmp/sqlmap", "description": "Output directory"}], "risk_level": "high", "requires": ["sqlmap"]}